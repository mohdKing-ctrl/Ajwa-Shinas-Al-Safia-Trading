# ---------------------------------------------------------------
#  Ajwa Shinas POS - Hostinger (Apache / LiteSpeed) settings
# ---------------------------------------------------------------
DirectoryIndex index.html
Options -Indexes

# Never let the server list folders or expose hidden/support files
<FilesMatch "^(\.git|\.gitignore|README\.md|.*\.sqlite.*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# --- Force HTTPS: remove the leading # on the next 3 lines AFTER the SSL
#     certificate shows as "Active" in hPanel -> Security -> SSL.
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# --- Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Browser caching: images for a month, code revalidated every time
#     (so an update you push to GitHub shows up on the next refresh)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png  "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
</IfModule>

# The API must never be cached
<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
